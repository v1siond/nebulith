<Layouts.app flash={@flash} width={:full}>
  <div class="px-4 pb-24 sm:px-8 lg:px-12">
    <header class="border-b border-base-300 pb-6 pt-10">
      <p class="mb-3 font-mono text-[11.5px] font-bold uppercase tracking-[0.2em] text-primary">
        Nebulith · database
      </p>
      <h1 class="mb-3 text-3xl font-bold tracking-tight sm:text-4xl">Tables</h1>
      <p class="text-base-content/70">
        {length(@tables)} tables, {@tables |> Enum.map(& &1.count) |> Enum.sum()} rows. Every table is
        read from Postgres, so one added by a migration appears here with no code change.
      </p>
    </header>

    <div class="mt-8 grid gap-3 sm:grid-cols-2 lg:grid-cols-3 2xl:grid-cols-4">
      <.link
        :for={table <- @tables}
        navigate={~p"/admin/#{table.name}"}
        class="group flex items-baseline justify-between gap-3 rounded-box border border-base-300 bg-base-200 px-4 py-3 transition hover:border-primary focus-visible:outline-2 focus-visible:outline-primary"
      >
        <span class="min-w-0">
          <span class="block truncate font-mono text-sm font-semibold group-hover:text-primary">
            {table.name}
          </span>
          <span :if={table.owner == :prisma} class="text-[11px] text-base-content/40">
            from the Prisma era
          </span>
        </span>
        <span class="shrink-0 font-mono text-xs tabular-nums text-base-content/50">
          {table.count}
        </span>
      </.link>
    </div>
  </div>
</Layouts.app>
