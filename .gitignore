# The directory Mix will write compiled artifacts to.
/_build/

# If you run "mix test --cover", coverage assets end up here.
/cover/

# The directory Mix downloads your dependencies sources to.
/deps/

# Where 3rd-party dependencies like ExDoc output generated docs.
/doc/

# Ignore .fetch files in case you like to edit your project deps locally.
/.fetch

# If the VM crashes, it generates a dump, let's ignore it too.
erl_crash.dump

# Also ignore archive artifacts (built via "mix archive.build").
*.ez

# Temporary files, for example, from tests.
/tmp/

# Ignore package tarball (built via "mix hex.build").
nebulith-*.tar

# Ignore assets that are produced by build tools.
/priv/static/assets/

# Ignore digested assets cache.
/priv/static/cache_manifest.json

# In case you use Node.js/npm, you want to ignore these.
npm-debug.log
/assets/node_modules/


# `mix assets.deploy` runs phx.digest, which writes a hash-named COPY and a .gz of EVERY static file
# right next to the original. Only /priv/static/assets was ignored, so running a production asset
# build locally used to drop ~1,400 digested tile PNGs into the working tree.
/priv/static/**/*.gz
/priv/static/**/*-????????????????????????????????.*

# Licensed stock REFERENCE art. The sources and the licence terms are recorded in
# docs/references/SOURCES.md, which IS tracked; the files themselves are not ours to redistribute,
# so they stay local. game-website had this rule and nebulith did not, which is how eight of them
# reached a commit here.
docs/references/**/*.jpg
docs/references/**/*.jpeg
docs/references/**/*.png
docs/references/**/*.webp
