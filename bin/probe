#!/usr/bin/env bash
#
# THE PROBES. Instruments, not gates.
#
#   bin/probe fps                 how many frames a big map draws
#   bin/probe treeSheet           stamp every tree species and measure the silhouettes
#   bin/probe groundCensus        what the ground of a generated world is made of
#
# These PRINT numbers. They do not assert, and they do not fail: their job is to answer a question
# you are holding, which is a different job from guarding a rule. Every gate that guards a rule is an
# Elixir scenario now, in test/e2e, and `bin/e2e` runs those. See docs/TESTING.md.
#
# `waterBorders` is the exception, still a gate and still here, waiting to be ported.
#
# They drive a separately booted server against nebulith_probe rather than the test endpoint, because
# a probe is something you run while looking at it, for as long as you like.
set -euo pipefail

cd "$(dirname "$0")/.."

export MIX_ENV=dev
export NEBULITH_DATABASE_URL="${E2E_DATABASE_URL:-ecto://postgres:postgres@localhost/nebulith_probe}"
export PORT="${E2E_PORT:-6329}"
export BASE="http://localhost:${PORT}"
export ADMIN_EMAIL="${ADMIN_EMAIL:-admin@nebulith.local}"
export ADMIN_PASSWORD="${ADMIN_PASSWORD:-12345678}"

# One gate with arguments, or a list of gates, or the default set.
GATE_ARGS=()
if [ $# -eq 0 ]; then
  GATES=(waterBorders)
elif [ $# -eq 1 ]; then
  GATES=("$1")
else
  GATES=("$1")
  shift
  GATE_ARGS=("$@")
fi

echo "probe: ${NEBULITH_DATABASE_URL} on :${PORT}"

# A FRESH DATABASE EVERY RUN. A gate that leaves rows behind is a gate that passes for the wrong
# reason the next time, and these gates author maps on purpose.
mix ecto.drop --quiet >/dev/null 2>&1 || true
mix ecto.create --quiet
mix ecto.migrate --quiet
mix run priv/repo/seeds.exs >/dev/null
mix assets.build >/dev/null

mix phx.server >/tmp/nebulith-e2e-server.log 2>&1 &
SERVER=$!
trap 'kill "$SERVER" 2>/dev/null || true' EXIT

until curl -sf "${BASE}/health" >/dev/null; do
  kill -0 "$SERVER" 2>/dev/null || { echo "the probe server died:"; tail -20 /tmp/nebulith-e2e-server.log; exit 1; }
  sleep 2
done
echo "probe: up"

cd assets
failed=0
for gate in "${GATES[@]}"; do
  echo
  echo "── ${gate} ──"
  node "e2e/${gate}.mjs" ${GATE_ARGS[@]+"${GATE_ARGS[@]}"} || failed=1
done

exit "$failed"
