#!/usr/bin/env bash
#
# THE END-TO-END LAYER: Playwright, driven from Elixir, inside `mix test`.
#
#   bin/e2e                              every scenario
#   bin/e2e test/e2e/phase_03_maps_test.exs   just that file
#   bin/e2e --only phase3                just the scenarios tagged phase3
#
# It runs against the TEST endpoint on the TEST database with the Ecto sandbox holding the
# transaction, so nothing a scenario clicks can reach a real saved map. See docs/TESTING.md.
#
# ── why a container ─────────────────────────────────────────────────────────────────────────────
# Playwright stopped shipping a chromium for Ubuntu 20.04 (focal) at 1.63, and the Elixir driver
# wants 1.63 or newer, so the local driver cannot start here. The documented route for exactly this
# is a Playwright SERVER reached over a websocket, which is what this starts.
#
# ── why the address is computed ─────────────────────────────────────────────────────────────────
# The browser runs in the container and has to reach the app on THIS machine. Under Docker Desktop
# `host.docker.internal` resolves to the Windows host rather than to this WSL distro, so it is
# refused; the distro's own address is the one that answers. Measured, not assumed: the container
# gets 200 from the distro address and a connection refusal from host.docker.internal.
set -euo pipefail

cd "$(dirname "$0")/.."

IMAGE="mcr.microsoft.com/playwright:v1.63.0-noble"
CONTAINER="nebulith-pw"
WS_PORT="${E2E_WS_PORT:-3111}"
APP_PORT="${E2E_APP_PORT:-4002}"

# This machine, as the container can see it. `hostname -I` gives the distro's own address.
HOST_IP="$(hostname -I | awk '{print $1}')"
[ -n "$HOST_IP" ] || { echo "could not work out this machine's address for the browser to call back on"; exit 1; }

start_browser() {
  echo "e2e: starting the playwright server on :${WS_PORT}"
  docker rm -f "$CONTAINER" >/dev/null 2>&1 || true
  docker run -d --name "$CONTAINER" \
    -p "127.0.0.1:${WS_PORT}:3000" \
    --add-host "wsl.host:${HOST_IP}" \
    --init --workdir /home/pwuser --user pwuser "$IMAGE" \
    /bin/sh -c "npx -y playwright@1.63.0 run-server --port 3000 --host 0.0.0.0" >/dev/null

  # Ready when it says so, not after a fixed sleep.
  for _ in $(seq 1 60); do
    docker logs "$CONTAINER" 2>&1 | grep -q "Listening on ws://" && return 0
    docker inspect -f '{{.State.Running}}' "$CONTAINER" 2>/dev/null | grep -q true || break
    sleep 1
  done
  echo "the playwright server did not come up:"
  docker logs "$CONTAINER" 2>&1 | tail -20
  exit 1
}

docker image inspect "$IMAGE" >/dev/null 2>&1 || docker pull "$IMAGE"

RUNNING="$(docker inspect -f '{{.State.Running}}' "$CONTAINER" 2>/dev/null || echo false)"
[ "$RUNNING" = "true" ] || start_browser

export PLAYWRIGHT_WS_ENDPOINT="ws://127.0.0.1:${WS_PORT}/"
export PHOENIX_TEST_BASE_URL="http://${HOST_IP}:${APP_PORT}"

echo "e2e: browser on ${PLAYWRIGHT_WS_ENDPOINT}, app at ${PHOENIX_TEST_BASE_URL}"

# A file or a flag runs exactly that. No arguments runs every scenario in test/e2e.
if [ $# -eq 0 ]; then
  exec mix test test/e2e --only e2e
fi
exec mix test "$@" --only e2e
